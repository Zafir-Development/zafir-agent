  "cards": [
    {
      "dot": "cyan",
      "title": "Путь одного сообщения",
      "items": [
        "Клиент отправляет prompt.submit в gateway-процесс",
        "Очередь допуска фиксирует ввод, затем AIAgent выполняет ход",
        "События и ответ стримятся всем подключённым зрителям сессии"
      ]
    },
    {
      "dot": "emerald",
      "title": "Что живёт в gateway",
      "items": [
        "Сессии, AIAgent, инструменты и платформенные адаптеры",
        "Cron и фоновые уведомления запускают новые ходы",
        "Процесс не привязан к окну клиента: отключение не отменяет ход"
      ]
    },
    {
      "dot": "violet",
      "title": "Расширения и состояние",
      "items": [
        "state.db хранит транскрипты, поиск FTS5 и очередь",
        "config.yaml, .env, скиллы и память — в HERMES_HOME профиля",
        "Плагины, MCP и субагенты добавляют возможности без роста ядра"
      ]
    }
